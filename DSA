// 1. Longest Subarray with Sum K

using System;
using System.Collections.Generic;

class Program1
{
    static int LongestSubarray(int[] arr, int k)
    {
        int prefixSum = 0;
        int maxLength = 0;
        Dictionary<int, int> firstIndex = new Dictionary<int, int>();

        for (int i = 0; i < arr.Length; i++)
        {
            prefixSum += arr[i];

            if (prefixSum == k)
                maxLength = i + 1;

            if (firstIndex.ContainsKey(prefixSum - k))
            {
                int length = i - firstIndex[prefixSum - k];
                maxLength = Math.Max(maxLength, length);
            }

            if (!firstIndex.ContainsKey(prefixSum))
                firstIndex[prefixSum] = i;
        }

        return maxLength;
    }

    static void Main()
    {
        int[] arr = { 10, 5, 2, 7, 1, 9 };
        int k = 15;

        Console.WriteLine(LongestSubarray(arr, k));
    }
}


// 2. Minimum Window Substring

using System;
using System.Collections.Generic;

class Program2
{
    static string MinWindow(string s, string t)
    {
        if (string.IsNullOrEmpty(s) || string.IsNullOrEmpty(t))
            return "";

        Dictionary<char, int> required = new Dictionary<char, int>();

        foreach (char ch in t)
        {
            if (!required.ContainsKey(ch))
                required[ch] = 0;

            required[ch]++;
        }

        int left = 0;
        int count = 0;
        int minLength = int.MaxValue;
        int start = 0;

        Dictionary<char, int> window = new Dictionary<char, int>();

        for (int right = 0; right < s.Length; right++)
        {
            char ch = s[right];

            if (!window.ContainsKey(ch))
                window[ch] = 0;

            window[ch]++;

            if (required.ContainsKey(ch) && window[ch] <= required[ch])
                count++;

            while (count == t.Length)
            {
                if (right - left + 1 < minLength)
                {
                    minLength = right - left + 1;
                    start = left;
                }

                char leftChar = s[left];
                window[leftChar]--;

                if (required.ContainsKey(leftChar) &&
                    window[leftChar] < required[leftChar])
                {
                    count--;
                }

                left++;
            }
        }

        if (minLength == int.MaxValue)
            return "";

        return s.Substring(start, minLength);
    }

    static void Main()
    {
        Console.WriteLine(MinWindow("ADOBECODEBANC", "ABC"));
    }
}


// 3. Merge Intervals

using System;
using System.Collections.Generic;

class Program3
{
    static int[][] MergeIntervals(int[][] intervals)
    {
        if (intervals.Length == 0)
            return Array.Empty<int[]>();

        Array.Sort(intervals, (a, b) => a[0].CompareTo(b[0]));

        List<int[]> result = new List<int[]>();
        result.Add(intervals[0]);

        for (int i = 1; i < intervals.Length; i++)
        {
            int[] current = intervals[i];
            int[] last = result[result.Count - 1];

            if (current[0] <= last[1])
            {
                last[1] = Math.Max(last[1], current[1]);
            }
            else
            {
                result.Add(current);
            }
        }

        return result.ToArray();
    }

    static void Main()
    {
        int[][] intervals =
        {
            new[] { 1, 3 },
            new[] { 2, 6 },
            new[] { 8, 10 },
            new[] { 9, 12 }
        };

        int[][] result = MergeIntervals(intervals);

        foreach (int[] interval in result)
        {
            Console.WriteLine($"[{interval[0]}, {interval[1]}]");
        }
    }
}


// 4. Kth Largest Element in a Stream

using System;

class KthLargest
{
    private int k;
    private PriorityQueue<int, int> heap;

    public KthLargest(int k, int[] nums)
    {
        this.k = k;
        heap = new PriorityQueue<int, int>();

        foreach (int num in nums)
            Add(num);
    }

    public int? Add(int val)
    {
        heap.Enqueue(val, val);

        if (heap.Count > k)
            heap.Dequeue();

        if (heap.Count < k)
            return null;

        return heap.Peek();
    }
}

class Program4
{
    static void Main()
    {
        KthLargest obj = new KthLargest(3, new[] { 4, 5, 8, 2 });

        Console.WriteLine(obj.Add(3));
        Console.WriteLine(obj.Add(5));
        Console.WriteLine(obj.Add(10));
        Console.WriteLine(obj.Add(9));
        Console.WriteLine(obj.Add(4));
    }
}


// 5. Remove Loop from Linked List

using System;

class Node
{
    public int Data;
    public Node Next;

    public Node(int data)
    {
        Data = data;
        Next = null;
    }
}

class Program5
{
    static Node RemoveLoop(Node head)
    {
        Node slow = head;
        Node fast = head;

        while (fast != null && fast.Next != null)
        {
            slow = slow.Next;
            fast = fast.Next.Next;

            if (slow == fast)
                break;
        }

        if (slow != fast)
            return head;

        slow = head;

        while (slow != fast)
        {
            slow = slow.Next;
            fast = fast.Next;
        }

        Node temp = slow;

        while (temp.Next != slow)
            temp = temp.Next;

        temp.Next = null;

        return head;
    }
}


// 6. Lowest Common Ancestor

using System;

class TreeNode
{
    public int Data;
    public TreeNode Left;
    public TreeNode Right;

    public TreeNode(int data)
    {
        Data = data;
        Left = null;
        Right = null;
    }
}

class Program6
{
    static TreeNode LowestCommonAncestor(
        TreeNode root,
        TreeNode p,
        TreeNode q)
    {
        if (root == null)
            return null;

        if (root == p || root == q)
            return root;

        TreeNode left = LowestCommonAncestor(root.Left, p, q);
        TreeNode right = LowestCommonAncestor(root.Right, p, q);

        if (left != null && right != null)
            return root;

        if (left != null)
            return left;

        return right;
    }
}


// 7. Shortest Path in Binary Matrix

using System;
using System.Collections.Generic;

class Program7
{
    static int ShortestPath(int[][] grid)
    {
        int n = grid.Length;

        if (n == 0)
            return -1;

        if (grid[0][0] == 1 || grid[n - 1][n - 1] == 1)
            return -1;

        Queue<(int row, int col, int distance)> queue =
            new Queue<(int row, int col, int distance)>();

        queue.Enqueue((0, 0, 1));

        int[][] directions =
        {
            new[] { -1, -1 },
            new[] { -1, 0 },
            new[] { -1, 1 },
            new[] { 0, -1 },
            new[] { 0, 1 },
            new[] { 1, -1 },
            new[] { 1, 0 },
            new[] { 1, 1 }
        };

        HashSet<(int, int)> visited =
            new HashSet<(int, int)>();

        visited.Add((0, 0));

        while (queue.Count > 0)
        {
            var current = queue.Dequeue();

            int row = current.row;
            int col = current.col;
            int distance = current.distance;

            if (row == n - 1 && col == n - 1)
                return distance;

            foreach (int[] direction in directions)
            {
                int newRow = row + direction[0];
                int newCol = col + direction[1];

                if (newRow >= 0 &&
                    newRow < n &&
                    newCol >= 0 &&
                    newCol < n &&
                    grid[newRow][newCol] == 0 &&
                    !visited.Contains((newRow, newCol)))
                {
                    visited.Add((newRow, newCol));
                    queue.Enqueue((newRow, newCol, distance + 1));
                }
            }
        }

        return -1;
    }
}


// 8. Course Schedule II

using System;
using System.Collections.Generic;

class Program8
{
    static int[] CourseOrder(int numCourses, int[][] prerequisites)
    {
        List<int>[] graph = new List<int>[numCourses];
        int[] indegree = new int[numCourses];

        for (int i = 0; i < numCourses; i++)
            graph[i] = new List<int>();

        foreach (int[] prerequisite in prerequisites)
        {
            int course = prerequisite[0];
            int prerequisiteCourse = prerequisite[1];

            graph[prerequisiteCourse].Add(course);
            indegree[course]++;
        }

        Queue<int> queue = new Queue<int>();

        for (int i = 0; i < numCourses; i++)
        {
            if (indegree[i] == 0)
                queue.Enqueue(i);
        }

        List<int> result = new List<int>();

        while (queue.Count > 0)
        {
            int course = queue.Dequeue();
            result.Add(course);

            foreach (int nextCourse in graph[course])
            {
                indegree[nextCourse]--;

                if (indegree[nextCourse] == 0)
                    queue.Enqueue(nextCourse);
            }
        }

        if (result.Count != numCourses)
            return Array.Empty<int>();

        return result.ToArray();
    }
}


// 9. Minimum Coins

using System;

class Program9
{
    static int MinimumCoins(int[] coins, int amount)
    {
        int[] dp = new int[amount + 1];

        Array.Fill(dp, amount + 1);

        dp[0] = 0;

        for (int i = 1; i <= amount; i++)
        {
            foreach (int coin in coins)
            {
                if (coin <= i)
                {
                    dp[i] = Math.Min(
                        dp[i],
                        dp[i - coin] + 1
                    );
                }
            }
        }

        if (dp[amount] == amount + 1)
            return -1;

        return dp[amount];
    }

    static void Main()
    {
        int[] coins = { 1, 2, 5 };
        int amount = 11;

        Console.WriteLine(MinimumCoins(coins, amount));
    }
}


// 10. Segment Tree

using System;

class SegmentTree
{
    private int n;
    private int[] tree;
    private int[] arr;

    public SegmentTree(int[] arr)
    {
        this.n = arr.Length;
        this.arr = arr;
        tree = new int[4 * n];

        Build(1, 0, n - 1);
    }

    private void Build(int node, int start, int end)
    {
        if (start == end)
        {
            tree[node] = arr[start];
            return;
        }

        int mid = (start + end) / 2;

        Build(node * 2, start, mid);
        Build(node * 2 + 1, mid + 1, end);

        tree[node] = Math.Max(
            tree[node * 2],
            tree[node * 2 + 1]
        );
    }

    private void Update(
        int node,
        int start,
        int end,
        int index,
        int value)
    {
        if (start == end)
        {
            tree[node] = value;
            return;
        }

        int mid = (start + end) / 2;

        if (index <= mid)
        {
            Update(
                node * 2,
                start,
                mid,
                index,
                value
            );
        }
        else
        {
            Update(
                node * 2 + 1,
                mid + 1,
                end,
                index,
                value
            );
        }

        tree[node] = Math.Max(
            tree[node * 2],
            tree[node * 2 + 1]
        );
    }

    private int Query(
        int node,
        int start,
        int end,
        int left,
        int right)
    {
        if (right < start || end < left)
            return int.MinValue;

        if (left <= start && end <= right)
            return tree[node];

        int mid = (start + end) / 2;

        int leftMax = Query(
            node * 2,
            start,
            mid,
            left,
            right
        );

        int rightMax = Query(
            node * 2 + 1,
            mid + 1,
            end,
            left,
            right
        );

        return Math.Max(leftMax, rightMax);
    }

    public void UpdateValue(int index, int value)
    {
        Update(
            1,
            0,
            n - 1,
            index,
            value
        );
    }

    public int RangeMax(int left, int right)
    {
        return Query(
            1,
            0,
            n - 1,
            left,
            right
        );
    }
}
